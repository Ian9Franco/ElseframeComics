# Server-only credentials. Copy this file to .env.local and fill in your values.
# .env.local is gitignored; use `npm run config:save` to persist it outside the repo.

# OpenAI — required for AI dialogue generation in the editor
OPENAI_API_KEY=your_openai_api_key_here

# Master password for draft chapters and the visual editor
PREVIEW_PASSWORD=your_master_password_here

# Asset CDN / local comics server
# Dev (npm run dev:all): app en http://localhost:616, assets en http://localhost:8080
# Dev (npm run dev):       app en http://localhost:3000, assets en http://localhost:8080
# Prod: https://cdn.jsdelivr.net/gh/Ian9Franco/theboyz-comic-v1@main
NEXT_PUBLIC_ASSETS_BASE_URL=http://localhost:8080

# Optional — raises GitHub API rate limits when syncing comics
# GITHUB_TOKEN=your_github_token_here
