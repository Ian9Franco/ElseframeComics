# Server-only credentials. Copy this file to .env.local and fill in your values.
# Valores reales: .env.local (está en .gitignore). Opcional: `npm run config:save` fuera del repo.
#
# En Vercel: Project → Settings → Environment Variables (Production + Preview según necesites).

# ─── Vercel / .env.local — app ───────────────────────────────────────────────

# [VERCEL] Generación de diálogos con IA en el editor
OPENAI_API_KEY=your_openai_api_key_here

# [VERCEL] Contraseña maestra (borradores + editor)
PREVIEW_PASSWORD=your_master_password_here

# [VERCEL] CDN de imágenes (público; el prefijo NEXT_PUBLIC_ expone al cliente)
# Dev (npm run dev:all): http://localhost:8080
# Dev (npm run dev):       http://localhost:8080
# Prod: https://cdn.jsdelivr.net/gh/Ian9Franco/theboyz-comic-v1@main
NEXT_PUBLIC_ASSETS_BASE_URL=http://localhost:8080

# ─── Vercel / .env.local — editor en producción (GitHub workspace) ───────────

# [VERCEL] Obligatoria en producción para guardar diálogos y disparar publicación.
# Fine-grained PAT: Contents (read/write) + Actions (read/write) en ElseframeComics (repo de la app).
# Si Publicar o Guardar JSON devuelven «Bad credentials», el token está mal, expiró o no tiene esos permisos.
# NO pongas acá ELSEFRAME_PUBLISH_TOKEN (ese secret es solo para GitHub Actions).
GITHUB_EDITOR_TOKEN=your_fine_grained_pat_here

# [VERCEL opcional] Solo lectura del repo de assets (rate limit). No mezclar con GITHUB_EDITOR_TOKEN.
# GITHUB_TOKEN=your_github_read_token_here

# [VERCEL opcional] Forzar backend del editor: local = filesystem; github = API (en dev podés probar GitHub).
# EDITOR_STORAGE=local
# EDITOR_STORAGE=github

# [VERCEL opcional] Overrides; si no las definís, el código usa estos defaults:
# GITHUB_EDITOR_BRANCH=editor-workspace
# GITHUB_OWNER=Ian9Franco
# GITHUB_MAIN_REPO=ElseframeComics
# GITHUB_ASSETS_REPO=theboyz-comic-v1

# ─── NO es variable de Vercel ────────────────────────────────────────────────
# [GitHub → ElseframeComics → Settings → Secrets and variables → Actions]
# ELSEFRAME_PUBLISH_TOKEN= mismo PAT (o uno dedicado) para publish-editor.yml (checkout/push de ambos repos).
